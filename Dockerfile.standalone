FROM rust:bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY rust ./rust
COPY experiments/wpe-sync/supervisor.rs ./supervisor.rs
COPY scripts/standalone-fixture.rs ./standalone-fixture.rs
RUN cargo build --release --locked && cargo test --release --locked && \
    rustc -O supervisor.rs -o jet-browser-supervisor && \
    rustc -O standalone-fixture.rs -o jet-browser-fixture

FROM debian:sid
ENV DEBIAN_FRONTEND=noninteractive \
    XDG_RUNTIME_DIR=/tmp/jet-browser-runtime \
    WAYLAND_DISPLAY=wayland-0 \
    LIBGL_ALWAYS_SOFTWARE=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    wpewebkit-webdriver libwpebackend-fdo-1.0-1 weston dbus-x11 \
    libgl1-mesa-dri ca-certificates curl fonts-noto-cjk fonts-noto-color-emoji && \
    useradd --create-home --uid 1000 browser && \
    install -d -o browser -g browser -m 0700 /tmp/jet-browser-runtime && \
    chmod -R a+rX /usr/share/glib-2.0 /usr/share/fonts /var/cache/fontconfig /etc/fonts && \
    rm -rf /var/lib/apt/lists/*
# Some OCI snapshotters preserve a restrictive root-directory mode from the
# base layer. The runtime is intentionally non-root, so every parent directory
# on executable/library paths must remain traversable.
RUN chmod 0755 /
COPY --from=build /build/target/release/jet-wpe /usr/local/bin/jet-wpe
COPY --from=build /build/jet-browser-supervisor /usr/local/bin/jet-browser-supervisor
COPY --from=build /build/jet-browser-fixture /usr/local/bin/jet-browser-fixture
COPY standalone-entrypoint.sh /usr/local/bin/standalone-entrypoint
RUN chmod 0755 /usr/local/bin/jet-wpe /usr/local/bin/jet-browser-supervisor /usr/local/bin/jet-browser-fixture /usr/local/bin/standalone-entrypoint
USER root
WORKDIR /home/browser
ENTRYPOINT ["/usr/local/bin/standalone-entrypoint"]
